/system         ext4     system                                     flags=display=system;logical;slotselect
/system_ext     ext4     system_ext                                 flags=display=system_ext;logical;slotselect
/vendor         ext4     vendor                                     flags=display=vendor;logical;slotselect
/odm            ext4     odm                                        flags=display=odm;logical;slotselect
/product        ext4     product                                    flags=display=product;logical;slotselect
/vendor_dlkm    ext4     vendor_dlkm                                flags=display=vendor_dlkm;logical;slotselect
/odm_dlkm       ext4     odm_dlkm                                   flags=display=odm_dlkm;logical;slotselect

# Userdata and Internal Partitions
/data           f2fs     /dev/block/bootdevice/by-name/userdata     flags=display=data;fileencryption=ice:aes-256-cts;wrappedkey;keydirectory=/metadata/vold/metadata_encryption
/metadata       f2fs     /dev/block/bootdevice/by-name/metadata     flags=display=metadata
/boot           emmc     /dev/block/bootdevice/by-name/boot         flags=display=boot;backup=1;flashimg=1;slotselect
/vendor_boot    emmc     /dev/block/bootdevice/by-name/vendor_boot  flags=display=vendor_boot;backup=1;flashimg=1;slotselect
/dtbo           emmc     /dev/block/bootdevice/by-name/dtbo         flags=display=dtbo;backup=1;flashimg=1;slotselect
/misc           emmc     /dev/block/bootdevice/by-name/misc         flags=display=misc

# External Storage
/sdcard         vfat     /dev/block/mmcblk1p1                       flags=display="MicroSD Card";storage;wipeingui;removable
/usb_otg        vfat     /dev/block/sdg1        /dev/block/sdg      flags=fsflags=utf8;display="USB Storage";storage;wipeingui;removable
