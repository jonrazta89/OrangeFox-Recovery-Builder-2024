diff --git a/BoardConfig.mk b/BoardConfig.mk
index 6fe222f..203e585 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -17,8 +17,14 @@ AB_OTA_PARTITIONS += \
     product \
     system_ext \
     vendor \
-    odm
-BOARD_USES_RECOVERY_AS_BOOT := true
+    odm \
+    vendor_dlkm \
+    odm_dlkm \
+    boot \
+    vendor_boot \
+    dtbo
+
+BOARD_USES_RECOVERY_AS_BOOT := false
 
 # Architecture
 TARGET_ARCH := arm64
@@ -56,20 +62,21 @@ TARGET_KERNEL_SOURCE := kernel/motorola/fogona
 TARGET_FORCE_PREBUILT_KERNEL := true
 ifeq ($(TARGET_FORCE_PREBUILT_KERNEL),true)
 TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilt/kernel
+BOARD_PREBUILT_DTBOIMAGE := $(DEVICE_PATH)/prebuilt/dtbo.img
 endif
 
 # Partitions
 BOARD_BOOTIMAGE_PARTITION_SIZE := 104857600
-BOARD_RECOVERYIMAGE_PARTITION_SIZE := 104857600
+BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE := 104857600
 BOARD_HAS_LARGE_FILESYSTEM := true
 BOARD_SYSTEMIMAGE_PARTITION_TYPE := ext4
-BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := ext4
+BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := f2fs
 BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
 TARGET_COPY_OUT_VENDOR := vendor
-BOARD_SUPER_PARTITION_SIZE := 9126805504 # TODO: Fix hardcoded value
+BOARD_SUPER_PARTITION_SIZE := 9126805504
 BOARD_SUPER_PARTITION_GROUPS := motorola_dynamic_partitions
-BOARD_MOTOROLA_DYNAMIC_PARTITIONS_PARTITION_LIST := system system_ext vendor odm product
-BOARD_MOTOROLA_DYNAMIC_PARTITIONS_SIZE := 9122611200 # TODO: Fix hardcoded value
+BOARD_MOTOROLA_DYNAMIC_PARTITIONS_PARTITION_LIST := system system_ext vendor odm product vendor_dlkm odm_dlkm
+BOARD_MOTOROLA_DYNAMIC_PARTITIONS_SIZE := 9122611200
 
 # Platform
 TARGET_BOARD_PLATFORM := bengal
@@ -80,21 +87,29 @@ TARGET_USERIMAGES_USE_EXT4 := true
 TARGET_USERIMAGES_USE_F2FS := true
 
 # Security patch level
-VENDOR_SECURITY_PATCH := 2021-08-01
+VENDOR_SECURITY_PATCH := 2099-12-31
+PLATFORM_SECURITY_PATCH := 2099-12-31
+PLATFORM_VERSION := 16.1.0
 
 # Verified Boot
 BOARD_AVB_ENABLE := true
 BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --flags 3
 
-# Hack: prevent anti rollback
-PLATFORM_SECURITY_PATCH := 2099-12-31
-VENDOR_SECURITY_PATCH := 2099-12-31
-PLATFORM_VERSION := 16.1.0
-
-# TWRP Configuration
+# TWRP / Touch Configuration
 TW_THEME := portrait_hdpi
 TW_EXTRA_LANGUAGES := true
 TW_SCREEN_BLANK_ON_BOOT := true
 TW_INPUT_BLACKLIST := "hbtp_vm"
 TW_USE_TOOLBOX := true
 TW_INCLUDE_REPACKTOOLS := true
+
+# Load vendor and vendor_boot kernel modules for Touch (Ilitek / Focaltech / Goodix)
+TW_LOAD_VENDOR_BOOT_MODULES := true
+TW_LOAD_VENDOR_MODULES := true
+
+# OrangeFox Configuration
+FOX_USE_TWRP_RECOVERY_IMAGE_BUILDER := 1
+OF_USE_GREEN_LED := 0
+OF_FLASHLIGHT_ENABLE := 0
+OF_ALLOW_DISABLE_NAVBAR := 0
+OF_QUICK_BACKUP_LIST := "/boot;/data;/system_image;/vendor_image;"
diff --git a/recovery.fstab b/recovery.fstab
index 1dcbcd0..5fd0cf8 100644
--- a/recovery.fstab
+++ b/recovery.fstab
@@ -3,8 +3,17 @@
 /vendor         ext4     vendor                                     flags=display=vendor;logical;slotselect
 /odm            ext4     odm                                        flags=display=odm;logical;slotselect
 /product        ext4     product                                    flags=display=product;logical;slotselect
-/data           f2fs     /dev/block/bootdevice/by-name/userdata     flags=display=data
+/vendor_dlkm    ext4     vendor_dlkm                                flags=display=vendor_dlkm;logical;slotselect
+/odm_dlkm       ext4     odm_dlkm                                   flags=display=odm_dlkm;logical;slotselect
+
+# Userdata and Internal Partitions
+/data           f2fs     /dev/block/bootdevice/by-name/userdata     flags=display=data;fileencryption=ice:aes-256-cts;wrappedkey;keydirectory=/metadata/vold/metadata_encryption
 /metadata       f2fs     /dev/block/bootdevice/by-name/metadata     flags=display=metadata
-/sdcard         vfat     /dev/block/mmcblk1p1                       flags=display=sdcard
-/boot           emmc     /dev/block/bootdevice/by-name/boot         flags=display=boot
+/boot           emmc     /dev/block/bootdevice/by-name/boot         flags=display=boot;backup=1;flashimg=1;slotselect
+/vendor_boot    emmc     /dev/block/bootdevice/by-name/vendor_boot  flags=display=vendor_boot;backup=1;flashimg=1;slotselect
+/dtbo           emmc     /dev/block/bootdevice/by-name/dtbo         flags=display=dtbo;backup=1;flashimg=1;slotselect
 /misc           emmc     /dev/block/bootdevice/by-name/misc         flags=display=misc
+
+# External Storage
+/sdcard         vfat     /dev/block/mmcblk1p1                       flags=display="MicroSD Card";storage;wipeingui;removable
+/usb_otg        vfat     /dev/block/sdg1        /dev/block/sdg      flags=fsflags=utf8;display="USB Storage";storage;wipeingui;removable
